---
import { Icon } from '@astrojs/starlight/components';

const label = Astro.locals.t('themeSelect.accessibleLabel');
const options = [
	{
		value: 'light',
		label: Astro.locals.t('themeSelect.light'),
		icon: 'sun' as const,
	},
	{
		value: 'dark',
		label: Astro.locals.t('themeSelect.dark'),
		icon: 'moon' as const,
	},
	{
		value: 'auto',
		label: Astro.locals.t('themeSelect.auto'),
		icon: 'laptop' as const,
	},
];
---

<starlight-theme-select>
	<div class="theme-icons" role="group" aria-label={label}>
		{
			options.map(({ value, label: optionLabel, icon }) => (
				<button
					type="button"
					class="theme-icon-btn"
					data-theme={value}
					aria-label={optionLabel}
					title={optionLabel}
				>
					<Icon name={icon} class="theme-icon" />
				</button>
			))
		}
	</div>
	{/* Select oculto: mantiene compatibilidad con ThemeProvider.updatePickers() */}
	<select class="sr-only" tabindex="-1" aria-hidden="true" autocomplete="off">
		{
			options.map(({ value, label: optionLabel }) => (
				<option value={value} selected={value === 'auto'} set:html={optionLabel} />
			))
		}
	</select>
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
		}
	}

	const getPreferredColorScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function syncButtons(theme: Theme): void {
		document.querySelectorAll('starlight-theme-select').forEach((picker) => {
			picker.querySelectorAll<HTMLButtonElement>('.theme-icon-btn').forEach((btn) => {
				const active = btn.dataset.theme === theme;
				btn.setAttribute('aria-pressed', String(active));
				btn.classList.toggle('is-active', active);
			});
		});
	}

	function onThemeChange(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
		storeTheme(theme);
		syncButtons(theme);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') onThemeChange('auto');
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			onThemeChange(loadTheme());
			this.querySelectorAll<HTMLButtonElement>('.theme-icon-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					onThemeChange(parseTheme(btn.dataset.theme));
				});
			});
			this.querySelector('select')?.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) {
					onThemeChange(parseTheme(e.currentTarget.value));
				}
			});
		}
	}

	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
	@layer starlight.components {
		.theme-icons {
			display: inline-flex;
			align-items: center;
			gap: 0.125rem;
			padding: 0.125rem;
			border-radius: 0.5rem;
			border: 1px solid var(--sl-color-gray-5);
			background-color: color-mix(in srgb, var(--sl-color-bg-nav) 70%, var(--sl-color-gray-6));
		}

		.theme-icon-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.75rem;
			height: 1.75rem;
			padding: 0;
			border: 0;
			border-radius: 0.375rem;
			color: var(--sl-color-gray-3);
			background: transparent;
			cursor: pointer;
			transition:
				color 0.15s ease,
				background-color 0.15s ease;
		}

		.theme-icon-btn:hover {
			color: var(--sl-color-white);
			background-color: var(--sl-color-gray-6);
		}

		.theme-icon-btn.is-active {
			color: var(--sl-color-accent-high);
			background-color: var(--sl-color-accent-low);
		}

		.theme-icon {
			font-size: 0.95rem;
		}

		select.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
	}
</style>
